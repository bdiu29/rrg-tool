# Create a .env file and copy this to .env and fill in your credentials

# Schwab Developer API — https://developer.schwab.com
SCHWAB_CLIENT_ID=your_app_key_here
SCHWAB_CLIENT_SECRET=your_app_secret_here
SCHWAB_URI=https://127.0.0.1

# Written automatically after OAuth — do not edit manually
# SCHWAB_ACCESS_TOKEN=
# SCHWAB_REFRESH_TOKEN=
# SCHWAB_TOKEN_EXPIRY=

# Screener alert delivery (optional) — leave blank to keep alerts in-app only
# Discord: a channel webhook URL
# DISCORD_WEBHOOK_URL=
# Email via SMTP (Gmail: smtp.gmail.com:465 + an app password, not your login)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=your_app_password
# ALERT_EMAIL_TO=you@gmail.com
