# Create a .env file and copy this to .env and fill in your credentials

# Schwab Developer API — https://developer.schwab.com
SCHWAB_CLIENT_ID=your_app_key_here
SCHWAB_CLIENT_SECRET=your_app_secret_here
SCHWAB_URI=https://127.0.0.1

# Written automatically after OAuth — do not edit manually
# SCHWAB_ACCESS_TOKEN=
# SCHWAB_REFRESH_TOKEN=
# SCHWAB_TOKEN_EXPIRY=

# Screener alert delivery (optional) — leave blank to keep alerts in-app only
# Discord: a channel webhook URL
# DISCORD_WEBHOOK_URL=
# Email via SMTP (Gmail: smtp.gmail.com:465 + an app password, not your login)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=your_app_password
# ALERT_EMAIL_TO=you@gmail.com

# --- Free data keys (optional — each progressively enriches a module) ---

# FRED (St. Louis Fed) — https://fred.stlouisfed.org/docs/api/api_key.html (free, instant)
# Activates: exact econ-release dates + FRED Actual/Previous + the Rates & Curve tab (news.html)
# FRED_API_KEY=

# Polygon.io / Massive — https://polygon.io (free tier)
# Free tier powers the News feed (Benzinga ticker news + sentiment, news.html).
# NOTE: the options trade tape / chains for the Flow module require a PAID Options plan
# (the free key 403s on options data), so flow stays on Schwab snapshots.
# POLYGON_IO_KEY=

# Finnhub — https://finnhub.io (free tier) — broad earnings calendar + EPS est/actual (news.html)
# FINNHUB_API_KEY=

# AlphaVantage — https://www.alphavantage.co/support/#api-key (free, ~25 req/day)
# News-feed sentiment + ticker tagging (Polygon covers this with a higher limit)
# ALPHAVANTAGE_API_KEY=